API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=123456789:your_bot_token_here

# Default limit. Keep below your server disk/network capacity and Telegram limits.
MAX_FILE_SIZE_MB=1900

# Upload backend:
# auto = try Bot API where useful, fallback to Telethon
# telethon = always use MTProto upload
# bot_api = use Bot API upload first; best with a local Bot API server
SEND_BACKEND=telethon
BOT_API_BASE_URL=https://api.telegram.org
FAST_URL_UPLOAD=true

# Network/progress tuning.
REQUEST_TIMEOUT_SECONDS=120
PROGRESS_UPDATE_SECONDS=1
MAX_CONCURRENT_JOBS=40
MAX_CONCURRENT_DOWNLOADS=25
MAX_CONCURRENT_UPLOADS=8
MAX_JOBS_PER_USER=1
PARALLEL_UPLOAD_ENABLED=true
PARALLEL_UPLOAD_THRESHOLD_MB=10
PARALLEL_UPLOAD_WORKERS=6

# Social-media downloader. Uses yt-dlp and works only for public/allowed media.
SOCIAL_DOWNLOAD_ENABLED=true
YTDLP_FORMAT=bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_EXTRACTOR_ARGS=
YTDLP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/135.0.0.0 Safari/537.36

# Relative paths are resolved from this project folder.
DATA_DIR=data
DOWNLOAD_DIR=downloads
PURGE_MEDIA_ON_START=false

# Admin and premium product settings.
ADMIN_IDS=
SESSION_TTL_SECONDS=900
METADATA_CACHE_TTL_SECONDS=900
TEMP_TTL_HOURS=6
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_EVENTS=20

# File-to-link module.
PUBLIC_BASE_URL=http://localhost:8080/files
PUBLIC_FILES_DIR=public_files
LINK_SERVER_ENABLED=true
LOCAL_LINK_STORAGE_ENABLED=true
LINK_SERVER_HOST=0.0.0.0
LINK_SERVER_PORT=8080
DEFAULT_LINK_TTL_HOURS=168
