# Baixa Aqui - exemplo de configuracao para VPS
# Copie para .env, preencha os segredos e mantenha chmod 600.

# Telegram
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=123456789:your_bot_token_here
ADMIN_IDS=
DEFAULT_LANGUAGE=pt

# Branding / UX
BOT_BRAND_NAME=Baixa Aqui
BOT_SUPPORT_USERNAME=
BOT_FOOTER_TEXT=Baixa Aqui | @Baixa_aquibot
BOT_STYLE_MODE=premium

# Caminhos
DATA_DIR=/opt/baixaaqui/data
DOWNLOAD_DIR=/opt/baixaaqui/downloads
PUBLIC_FILES_DIR=/opt/baixaaqui/public_files
LOG_DIR=/opt/baixaaqui/logs
PURGE_MEDIA_ON_START=false
TEMP_TTL_HOURS=6

# Limites e fila
MAX_FILE_SIZE_MB=4096
REQUEST_TIMEOUT_SECONDS=120
PROGRESS_UPDATE_SECONDS=1
MAX_CONCURRENT_JOBS=12
MAX_CONCURRENT_INSPECTIONS=24
MAX_CONCURRENT_DOWNLOADS=8
MAX_CONCURRENT_UPLOADS=4
MAX_JOBS_PER_USER=3
JOB_TIMEOUT_SECONDS=7200
PENDING_TARGETS_LIMIT=10000
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_EVENTS=20

# Downloads sociais
SOCIAL_DOWNLOAD_ENABLED=false
YTDLP_FORMAT=bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best
YTDLP_CONCURRENT_FRAGMENTS=4
YTDLP_EXTRACTOR_ARGS=youtube:player_client=web
YTDLP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/135.0.0.0 Safari/537.36

# Cookies fixos do dono do bot. Use cookies.txt Netscape/Mozilla exportado do navegador.
YTDLP_COOKIES_FILE=
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_COOKIES_MAX_AGE_HOURS=72
YTDLP_COOKIES_YOUTUBE=/opt/baixaaqui/cookies/youtube.txt
YTDLP_COOKIES_INSTAGRAM=/opt/baixaaqui/cookies/instagram.txt
YTDLP_COOKIES_TIKTOK=/opt/baixaaqui/cookies/tiktok.txt
YTDLP_COOKIES_TWITTER=/opt/baixaaqui/cookies/twitter.txt
YTDLP_COOKIES_FACEBOOK=/opt/baixaaqui/cookies/facebook.txt
YTDLP_COOKIES_CRUNCHYROLL=/opt/baixaaqui/cookies/crunchyroll.txt
GALLERY_DL_CONFIG=/opt/baixaaqui/cookies/gallery-dl.conf

# Upload Telegram
SEND_BACKEND=auto
BOT_API_BASE_URL=https://api.telegram.org
FAST_URL_UPLOAD=true
TURBO_MODE=false
TURBO_ARIA2_CONNECTIONS=16
TURBO_ARIA2_SPLIT=16
TURBO_ARIA2_MIN_SPLIT_SIZE=1M
PARALLEL_UPLOAD_ENABLED=true
PARALLEL_UPLOAD_THRESHOLD_MB=10
PARALLEL_UPLOAD_WORKERS=8

# Links publicos
PUBLIC_BASE_URL=https://seu-dominio.com/files
LINK_SERVER_ENABLED=true
LOCAL_LINK_STORAGE_ENABLED=true
LINK_SERVER_HOST=0.0.0.0
LINK_SERVER_PORT=8080
DEFAULT_LINK_TTL_HOURS=168

# Grupos
GROUP_AUTO_DOWNLOAD=true
GROUP_SILENT_MODE=true
GROUP_REPLY_ON_ERROR=false
GROUP_ALLOWED_CHATS=
GROUP_BLOCKED_CHATS=
GROUP_WHITELIST_MODE=false
GROUP_MAX_FILE_SIZE_MB=50
GROUP_RATE_LIMIT_WINDOW_SECONDS=60
GROUP_RATE_LIMIT_MAX_EVENTS=6

# Cache / banco
SESSION_TTL_SECONDS=900
METADATA_CACHE_TTL_SECONDS=1800

# Seguranca
ALLOW_PRIVATE_DOWNLOADS=false

# Observabilidade
LOG_LEVEL=INFO
LOG_FORMAT=text
