API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=123456789:your_bot_token_here
ADMIN_IDS=123456789

# Faster path on VPS. Keep "auto" unless you are forcing a specific backend.
SEND_BACKEND=auto
BOT_API_BASE_URL=http://127.0.0.1:8081
FAST_URL_UPLOAD=true

# Network and concurrency tuning for production.
REQUEST_TIMEOUT_SECONDS=120
PROGRESS_UPDATE_SECONDS=1
MAX_CONCURRENT_JOBS=120
MAX_CONCURRENT_INSPECTIONS=180
MAX_CONCURRENT_DOWNLOADS=40
MAX_CONCURRENT_UPLOADS=16
MAX_JOBS_PER_USER=2
PARALLEL_UPLOAD_ENABLED=true
PARALLEL_UPLOAD_THRESHOLD_MB=12
PARALLEL_UPLOAD_WORKERS=8

# Downloader defaults.
MAX_FILE_SIZE_MB=1900
SOCIAL_DOWNLOAD_ENABLED=true
YTDLP_FORMAT=bestvideo[ext=mp4]+bestaudio[ext=m4a]/best[ext=mp4]/best
YTDLP_COOKIES_FILE=/opt/baixa-aquibot/secrets/youtube-cookies.txt
YTDLP_COOKIES_CRUNCHYROLL=/opt/baixaaqui/cookies/crunchyroll.txt
YTDLP_COOKIES_FROM_BROWSER=
YTDLP_EXTRACTOR_ARGS=
YTDLP_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/135.0.0.0 Safari/537.36
DOWNLOAD_PROXY=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_DB_CHANNEL_ID=
GENIUS_TOKEN=
MUSIC_COLLECTION_LIMIT=10

# Persistent metadata lives here. Media stays ephemeral.
DATA_DIR=/var/lib/baixa-aqui-bot/data
DOWNLOAD_DIR=/tmp/baixa-aqui-bot/downloads
PURGE_MEDIA_ON_START=true
TEMP_TTL_HOURS=1
SESSION_TTL_SECONDS=900
METADATA_CACHE_TTL_SECONDS=600
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_EVENTS=25

# Disable local file hosting so downloaded content is never kept on disk after completion.
LOCAL_LINK_STORAGE_ENABLED=false
LINK_SERVER_ENABLED=false
PUBLIC_BASE_URL=
PUBLIC_FILES_DIR=/tmp/baixa-aqui-bot/public_files
DEFAULT_LINK_TTL_HOURS=24
